# Excluded from the Cloudflare Workers assets upload (assets.directory = repo root).
# These are kept in the repo but must NOT be served.

# version control + tooling (the .git packfile alone is >25 MiB → build blocker)
.git
.gitignore
.gitattributes
.DS_Store
.claude
.assetsignore
wrangler.jsonc
TASKS.md

# story SOURCE files (served renditions live in stories/<story>/img/)
stories/*/trip.md
stories/*/story.json
stories/*/*.jpg
stories/*/*.JPG
stories/*/*.jpeg
stories/*/*.JPEG
stories/*/*.png
stories/*/*.PNG
stories/*/*.heic
stories/*/*.HEIC

# Stories section held back from the live site (kept local until ready).
# /stories/ serves only the "coming soon" index; the real listing + the
# rendered story pages stay in the repo but are NOT uploaded/served.
stories/_index-full.html
stories/bangkok/
stories/cambodia/

# build engine (carries a package.json)
tools/
